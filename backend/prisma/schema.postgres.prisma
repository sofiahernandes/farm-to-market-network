generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                @id @default(cuid())
  email         String                @unique
  cpfHash       String                @unique
  maskedCpf     String                @default("***.982.247-25")
  passwordHash  String
  role          String                @default("consumer")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  subscriptions Subscription[]
  lgpdRequests  LgpdDeletionRequest[]
  auditLogs     AuditLog[]
}

model Producer {
  id                      String                  @id @default(cuid())
  displayName             String
  city                    String                  @default("Ibiúna")
  state                   String                  @default("SP")
  story                   String                  @default("Propriedade familiar dedicada a hortaliças orgânicas e cestas agroecológicas colhidas na véspera da entrega.")
  legalIdMasked           String                  @default("***.982.247-25 · DAP/CAF Ativo")
  onboardingStatus        String                  @default("approved")
  paymentAccountConnected Boolean                 @default(true)
  splitFeatureFlagEnabled Boolean                 @default(false)
  platformFeePercent      Int                     @default(10)
  createdAt               DateTime                @default(now())
  products                Product[]
  baskets                 Basket[]
  certifications          ProducerCertification[]
  zones                   ServiceZone[]
}

model ProducerCertification {
  id         String   @id @default(cuid())
  producerId String
  name       String
  issuer     String
  validUntil String
  status     String   @default("valid")
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
}

model ServiceZone {
  id               String         @id @default(cuid())
  name             String         @unique
  postalCodePrefix String
  city             String         @default("São Paulo")
  cutoffHours      Int            @default(36)
  active           Boolean        @default(true)
  producerId       String?
  producer         Producer?      @relation(fields: [producerId], references: [id])
  addresses        Address[]
  slots            DeliverySlot[]
  routes           ManualRoute[]
}

model Address {
  id            String         @id @default(cuid())
  userId        String
  zoneId        String?
  label         String         @default("Endereço principal")
  isDefault     Boolean        @default(false)
  postalCode    String
  street        String
  number        String
  complement    String?
  city          String
  state         String
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id])
  zone          ServiceZone?   @relation(fields: [zoneId], references: [id])
  orders        Order[]
  subscriptions Subscription[]
}

model DeliverySlot {
  id            String         @id @default(cuid())
  zoneId        String
  label         String         @default("Quarta-feira · 08h às 12h")
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  active        Boolean        @default(true)
  zone          ServiceZone    @relation(fields: [zoneId], references: [id])
  orders        Order[]
  routes        ManualRoute[]
  subscriptions Subscription[]
}

model Product {
  id              String      @id @default(cuid())
  producerId      String
  name            String
  description     String?
  category        String
  unit            String
  priceCents      Int
  active          Boolean     @default(true)
  certification   String      @default("Orgânico Participativo (OPAC)")
  seasonality     String      @default("Safra atual · Colheita sob demanda")
  basketItemsJson String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  producer        Producer    @relation(fields: [producerId], references: [id])
  inventory       Inventory[]
  baskets         Basket[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

model Inventory {
  id                String                @id @default(cuid())
  productId         String
  deliveryDate      DateTime
  available         Int
  reserved          Int                   @default(0)
  lowStockThreshold Int                   @default(5)
  product           Product               @relation(fields: [productId], references: [id])
  allocations       InventoryAllocation[]

  @@unique([productId, deliveryDate])
}

model Basket {
  id              String         @id @default(cuid())
  slug            String         @unique
  productId       String
  producerId      String
  name            String
  subtitle        String
  description     String
  priceCents      Int
  servesLabel     String
  cutoffHours     Int            @default(36)
  frequenciesJson String         @default("[\"weekly\",\"monthly\"]")
  itemsJson       String
  active          Boolean        @default(true)
  product         Product        @relation(fields: [productId], references: [id])
  producer        Producer       @relation(fields: [producerId], references: [id])
  subscriptions   Subscription[]
}

model Subscription {
  id             String              @id @default(cuid())
  userId         String
  basketId       String
  addressId      String
  deliverySlotId String
  frequency      String              @default("weekly")
  priceCents     Int
  status         String              @default("active")
  cutoffHours    Int                 @default(36)
  nextBillingAt  DateTime
  nextDeliveryAt DateTime
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  user           User                @relation(fields: [userId], references: [id])
  basket         Basket              @relation(fields: [basketId], references: [id])
  address        Address             @relation(fields: [addressId], references: [id])
  deliverySlot   DeliverySlot        @relation(fields: [deliverySlotId], references: [id])
  cycles         SubscriptionCycle[]
}

model SubscriptionCycle {
  id             String       @id @default(cuid())
  subscriptionId String
  cycleKey       String
  deliveryDate   DateTime
  billingDate    DateTime
  amountCents    Int
  status         String       @default("confirmed")
  paymentStatus  String       @default("approved")
  orderId        String?
  note           String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, cycleKey])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model ManualRoute {
  id         String       @id @default(cuid())
  name       String
  zoneId     String
  slotId     String
  driverName String
  status     String       @default("open")
  createdAt  DateTime     @default(now())
  zone       ServiceZone  @relation(fields: [zoneId], references: [id])
  slot       DeliverySlot @relation(fields: [slotId], references: [id])
  orders     Order[]
}

model Order {
  id                String                @id @default(cuid())
  userId            String
  addressId         String
  deliverySlotId    String
  routeId           String?
  status            String                @default("confirmed")
  operationalStage  String                @default("preparing")
  producerSeparated Boolean               @default(false)
  totalCents        Int
  idempotencyKey    String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id])
  address           Address               @relation(fields: [addressId], references: [id])
  deliverySlot      DeliverySlot          @relation(fields: [deliverySlotId], references: [id])
  route             ManualRoute?          @relation(fields: [routeId], references: [id])
  items             OrderItem[]
  payment           Payment?
  delivery          Delivery?
  statusHistory     OrderStatusHistory[]
  allocations       InventoryAllocation[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

model InventoryAllocation {
  id          String    @id @default(cuid())
  inventoryId String
  orderId     String
  productId   String
  quantity    Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, orderId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  provider          String
  providerPaymentId String
  status            String
  amountCents       Int
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Delivery {
  id          String    @id @default(cuid())
  orderId     String    @unique
  status      String
  confirmedAt DateTime?
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actor      String?
  changedAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OperationalException {
  id             String    @id @default(cuid())
  type           String
  severity       String    @default("medium")
  referenceId    String
  title          String
  description    String
  status         String    @default("open")
  resolutionNote String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
}

model LgpdDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  protocol    String    @unique
  reason      String
  status      String    @default("pending_review")
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  resourceType  String
  resourceId    String
  summary       String?
  correlationId String?
  metadata      Json
  createdAt     DateTime @default(now())
  actor         User?    @relation(fields: [actorUserId], references: [id])
}
